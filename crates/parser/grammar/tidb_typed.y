Expression -> Expr:
    singleAtIdentifier assignmentEq Expression %prec assignmentEq { Expr::Variable(Box::new(VariableExpr { name: at_ident_text($lexer.src_str(tok_span(&$1))), value: Some($3), ..Default::default() })) }
